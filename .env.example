# Copy to .env for local use. NEVER commit .env (it is in .gitignore).
# On Render, set these in the service's Environment tab instead.
PORT=3001
NODE_ENV=development
# Public base URL of the app: used to build the OAuth callback URL.
BASE_URL=http://localhost:3001
JWT_SECRET=replace-with-a-long-random-string
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: SQLite file location (default server/data/capsules.db)
DB_PATH=
